; example custom platformio ini file for EMS-ESP

[common]
; custom build flags to use in my_build_flags
;  -D EMSESP_UART_DEBUG ; debugging UART
;  -D EMSESP_DEBUG ; enables DEBUG to the log. Will generate a lot of extra traffic on Console and Syslog
;  -D EMSESP_DEFAULT_BOARD_PROFILE=\"NODEMCU\" ; hard code the default board name
;  -D EMSESP_DEBUG_SENSOR ; additional debug for the sensors
;  -D CORE_DEBUG_LEVEL=5 ; verbose core level debugging 5=verbose, 4=debug, 3=info
;  -D EMSESP_TEST ; enable the tests. EN language only
;  -D EMSESP_DE_ONLY ; only DE translated entity names
;  -D EMSESP_EN_ONLY ; only EN translated entity names
;  -D EMSESP_PINGTEST ; send log message every 1/2 second
;  -D EMSESP_GATEWAY_TX_HOLD ; hold Tx while a K30RF/KM200 gateway is syncing, see issue #3094

; my_build_flags = -DEMSESP_TEST -DEMSESP_DEBUG
; my_build_flags = -DEMSESP_DEBUG -DEMSESP_TEST -DEMSESP_PINGTEST
; my_build_flags = -DEMSESP_DEBUG -DCORE_DEBUG_LEVEL=5
; my_build_flags = -DEMSESP_EN_ONLY -DEMSESP_TEST -DCORE_DEBUG_LEVEL=5 -DARDUINO_USB_CDC_ON_BOOT=1
; my_build_flags = -DEMSESP_EN_ONLY
; my_build_flags = -DEMSESP_DEBUG
; my_build_flags = -D EMSESP_GATEWAY_TX_HOLD
my_build_flags =

[platformio]
; default_envs = s_16M_P, recovery_s_16M_P, build-recovery, build-webUI
default_envs = s_16M_P ; BBQKees E32V2
; default_envs = s_16M_P_custom ; BBQKees E32V2 with custom Arduino/IDF libs
; default_envs = recovery_s_16M_P ; recovery firmware
; default_envs = crashtest_s_16M_P ; crash test
; default_envs = build-webUI ; build the main ems-esp webUI only
; default_envs = build-recovery ; build the recovery WebUI only
; default_envs = s3_16M_P ; BBQKees S3 firmware
; default_envs = s_4M ; firmware forBBQKees older S32, 4MB no psram
; default_envs = s_16M ; firmware for BBQKees newer S32 V2, 16MB no psram
; default_envs = c6 ; firmware for XIAO ESP32C
; default_envs = debug ; see below

[env]

; uncomment if you want to upload the firmware via OTA (must have upload_protocol = custom)
extra_scripts =
 post:scripts/rename_fw.py ; renames the firmware .bin file
 scripts/upload.py ; optionally upload the firmware via OTA (must have upload_protocol = custom)

; set the username and password for the admin account (default password is admin)
custom_username = admin
custom_password = admin2

; ** upload settings **
; for direct USB, which is the default you can set an optional port for example:
; upload_port = /dev/ttyUSB0
; upload_port = /dev/ttyACM0

; CH340G bridge tops out here reliably; drop back to 460800 if uploads fail
; 2000000 is the max speed for the CH340G bridge
; upload_speed = 921600
upload_speed = 2000000

; for direct via HTTP (OTA) set:
upload_protocol = custom
; custom_emsesp_ip = ems-esp.local ; E32V2.2 (test)
custom_emsesp_ip = ems-espP.local ; E32V2.2 (prod)
; custom_emsesp_ip = ems-esps32.local ; S32, 4MB no psramS32
; custom_emsesp_ip = ems-espS3.local ; ems-espS3

; lib_deps =
;   bblanchon/ArduinoJson @ 7.4.3
;   ESP32Async/AsyncTCP @ 3.6.1
;   ESP32Async/ESPAsyncWebServer @ 3.11.0
;   https://github.com/mobizt/ReadyMail.git @ 0.4.0
;   https://github.com/mobizt/ESP_SSLClient.git @ 3.1.3
  ; https://github.com/emsesp/EMS-ESP-Modules.git @ 1.0.8
;   ; file://${PROJECT_DIR}/../modules/EMS-ESP-Modules

; pio run -e recovery_s_16M_P -t upload 
[env:recovery_s_16M_P]
upload_protocol = custom

; ** debug settings **
; to be used with an ESP32-S3 which has an onboard JTAG, connect the OTG USB port to the PC
; if using an external JTAG board like the ESP-PROG set debug_tool = esp-prog, and use zadig to set the correct driver for the USB port
; see https://docs.platformio.org/en/stable/projectconf/sections/env/options/debug/debug_init_break.html for settings
; use with my_build_flags = -DEMSESP_EN_ONLY -DEMSESP_TEST -DCORE_DEBUG_LEVEL=5 -DARDUINO_USB_CDC_ON_BOOT=1
[env:debug]
board = esp32-s3-devkitc-1
framework = arduino
platform = espressif32@6.12.0 ; Arduino Core v2.0.17 / IDF v4.4.7
board_build.partitions = partitions/esp32_partition_16M.csv
board_upload.flash_size = 16MB
board_build.app_partition_name = app0
board_build.filesystem = littlefs
upload_protocol = esptool
build_type = debug
monitor_raw = no
monitor_filters = colorize, esp32_exception_decoder
debug_tool = esp-builtin
debug_init_break = 
upload_speed = 2000000
monitor_speed = 115200
extra_scripts =

[env:s_16M_P_custom]
; same as s_16M_P, but the Arduino/IDF libs are rebuilt with HybridCompile using the custom_sdkconfig below
; this is same procedure as in the esp32-arduino-lib-builder repository https://github.com/emsesp/esp32-arduino-lib-builder/blob/emsesp/configs/defconfig.ems-esp
; SPI Ethernet is left enabled: Arduino ETH.cpp needs those types; unused W5500/DM9051 objects are GC'd
extends = env:s_16M_P
custom_sdkconfig =
  '# CONFIG_BT_ENABLED is not set'
  '# CONFIG_LWIP_PPP_SUPPORT is not set'
  '# CONFIG_LWIP_IP_FORWARD is not set'
  '# CONFIG_LWIP_IPV4_NAPT is not set'
  '# CONFIG_LWIP_IPV4_NAPT_PORTMAP is not set'
  '# CONFIG_ULP_COPROC_ENABLED is not set'
  '# CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS is not set'
  '# CONFIG_FREERTOS_USE_TRACE_FACILITY is not set'
  '# CONFIG_FREERTOS_ENABLE_TASK_SNAPSHOT is not set'
  '# CONFIG_ESP_MODEM_USE_PPP_MODE is not set'
  '# CONFIG_ESP_GDBSTUB_ENABLED is not set'
  '# CONFIG_ESP_NETIF_REPORT_DATA_TRAFFIC is not set'
  '# CONFIG_MDNS_ENABLE_CONSOLE_CLI is not set'
  '# CONFIG_MDNS_ENABLE_BROWSE is not set'
  '# CONFIG_I2S_ISR_IRAM_SAFE is not set'
  # UART ISR must live in IRAM. Tasmota puts ringbuf ISRs in flash, which
  # forces CONFIG_UART_ISR_IN_IRAM=n and panics (Cache error) when the EMS
  # or console UART fires during a flash read (WiFi stop / mDNS / NVS).
  # CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH is not set'
  'CONFIG_UART_ISR_IN_IRAM=y'
  'CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256'
  'CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=1024'
  'CONFIG_LWIP_LOCAL_HOSTNAME="ems-esp"'
  'CONFIG_TINYUSB_DESC_CDC_STRING="EMS-ESP CDC Device"'

  # Moderate buffer trims only. Avoid SPIRAM_TRY_ALLOCATE_WIFI_LWIP,
  # SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY, and mDNS-from-SPIRAM on ESP32 —
  # those caused boot loops on Ethernet boards.

  'CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=0'
  'CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6'
  'CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16'
  'CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16'
  'CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16'
  'CONFIG_ESP_WIFI_RX_BA_WIN=4'
  'CONFIG_ESP_WIFI_TX_BA_WIN=4'

  'CONFIG_MDNS_MAX_SERVICES=4'
  'CONFIG_MDNS_ACTION_QUEUE_LEN=8'

  'CONFIG_ETH_DMA_RX_BUFFER_NUM=6'
  'CONFIG_ETH_DMA_TX_BUFFER_NUM=6'

  'CONFIG_LWIP_MAX_ACTIVE_TCP=10'
  'CONFIG_LWIP_MAX_LISTENING_TCP=8'
  'CONFIG_LWIP_MAX_UDP_PCBS=8'
  'CONFIG_LWIP_MAX_RAW_PCBS=4'
  'CONFIG_LWIP_IPV6_NUM_ADDRESSES=2'

  # Save a core dump to the coredump partition on a crash, EMS-ESP reads and reports it after the restart.
  # Boards without a coredump partition (4MB) only log that there's none at boot.
  'CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y'
  # CONFIG_ESP_COREDUMP_ENABLE_TO_NONE is not set
  'CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y'

  # New firmware stays pending verification until EMS-ESP confirms it after 2 minutes, a crash or restart before
  # then makes the bootloader roll back to the previous firmware. Only boards flashed over serial get the bootloader.
  'CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y'
