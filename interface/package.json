{
  "name": "EMS-ESP",
  "version": "3.10.0",
  "description": "EMS-ESP WebUI",
  "homepage": "https://emsesp.org",
  "author": "emsesp.org",
  "license": "GPL-3.0-or-later",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "build-hosted": "typesafe-i18n --no-watch && vite build --mode hosted",
    "mock-rest": "bun --watch ../mock-api/restServer.ts",
    "preview-standalone": "typesafe-i18n --no-watch && vite build && concurrently -c \"auto\" \"pnpm:mock-rest\" \"vite preview\"",
    "standalone": "concurrently -c \"auto\" \"typesafe-i18n\" \"pnpm:mock-rest\" \"vite dev\"",
    "typesafe-i18n": "typesafe-i18n --no-watch",
    "build-webUI": "typesafe-i18n --no-watch && vite build && node progmem-generator.js",
    "size-report": "node size-report.js",
    "check-layout": "node check-layout.js",
    "translate": "node translate-missing.js",
    "backtranslate-check": "node backtranslate-check.js",
    "recovery": "vite dev --mode recovery",
    "build-recovery": "typesafe-i18n --no-watch && vite build --mode recovery && node progmem-generator.js --src ./dist-recovery --out ../recovery/WWWData.h --index recovery.html",
    "format": "prettier -l -w '**/*.{ts,tsx,js,css,json,md}'",
    "lint": "eslint . --fix",
    "standalone-devcontainer": "concurrently -c \"auto\" \"typesafe-i18n\" \"pnpm:mock-rest\" \"vite --host\""
  },
  "dependencies": {
    "@alova/adapter-xhr": "2.3.3",
    "alova": "^3.5.5",
    "jwt-decode": "^4.0.0",
    "preact": "^11.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "typesafe-i18n": "^5.27.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gfx/zopfli": "^1.0.15",
    "@preact/preset-vite": "^2.10.6",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "etag": "^1.8.1",
    "mime-types": "^3.0.2",
    "playwright-core": "^1.65.1",
    "prettier": "^3.10.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "terser": "^5.51.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4"
}
