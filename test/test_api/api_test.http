# testing EMS-ESP API
# to be used with "REST Client" extension in Visual Studio Code (https://marketplace.visualstudio.com/items?itemName=humao.rest-client)
# Open this file in VSC, set the API key and the sign-in below, go to the API call and click on 'Send Request' (or Ctrl+Alt+R)
# The response will be shown in the right panel

@host = http://ems-esp.local
@host_dev = http://ems-espT.local
@host_standalone = http://localhost:3080
@host_standalone2 = http://localhost:3082

# every /api call needs an API key, create a "Read and Write" one in Security > API Keys
@key = emsesp_...

# /rest needs a WebUI sign-in instead: send the signin request below first, the others reuse its token
@username = admin
@password = ...
@session = {{signin.response.body.access_token}}

# @name signin
POST {{host}}/rest/signIn
Content-Type: application/json

{
    "username" : "{{username}}",
    "password" : "{{password}}"
}

###

GET {{host}}/api/system/info
Authorization: Bearer {{key}}

###

GET {{host}}/api/thermostat/seltemp
Authorization: Bearer {{key}}

###

POST {{host}}/api/system/message
Content-Type: application/json
Authorization: Bearer {{key}}

{
    "value" : "system/settings/locale"
}


###

POST {{host}}/api/thermostat/seltemp
Content-Type: application/json
Authorization: Bearer {{key}}

{
    "value" : 21.0
}

###

POST {{host}}/api/thermostat
Content-Type: application/json
Authorization: Bearer {{key}}

{
    "entity" : "seltemp",
    "value" : 21.0
}

###

POST {{host}}/api
Content-Type: application/json
Authorization: Bearer {{key}}

{
    "device" : "boiler",
    "entity" : "dhw/tapactivated",
    "value" : "on"
}

###

GET {{host}}/api/system/restart
Authorization: Bearer {{key}}

###

GET {{host}}/api/boiler/coldshot
Authorization: Bearer {{key}}

###

GET {{host}}/api/temperaturesensor/info
Authorization: Bearer {{key}}

###

GET {{host}}/rest/deviceData?id=3
Content-Type: application/json
Authorization: Bearer {{session}}

###

GET {{host}}/api/boiler/commands
Authorization: Bearer {{key}}

###

POST {{host}}/api/custom/test_custom
Content-Type: application/json
Authorization: Bearer {{key}}

{
    "value" : 22.0
}

###

GET {{host}}/api/custom/test_custom
Authorization: Bearer {{key}}

